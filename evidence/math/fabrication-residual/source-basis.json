    },
    {
      "locator": "word/document.xml::p[5549]",
      "text": "I/O: exact or bounded pricing proof for every net \\(\\to\\) closure certificate.\nTrust: trusted.\nRequires global lower bound \\(\\underline z_n^{price}\\ge0\\).\nFailure: PRICING_INCOMPLETE; UNKNOWN preserved.\nTime: proof replay. Checkpoint: closure root.",
      "text_sha256": "486c111b463564e4fe5c88b8ab206f009774ef362d2de46207b4785cc4d5341e"
