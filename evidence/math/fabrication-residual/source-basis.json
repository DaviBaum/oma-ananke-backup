    },
    {
      "locator": "word/document.xml::p[5547]",
      "text": "I/O: same \\(\\to\\) candidate columns only.\nTrust: untrusted. Mode: heuristic.\nFailure: none found returns NO_CANDIDATE_FOUND, not closure.\nTime: budgeted. Checkpoint: optional proposal frontier.",
      "text_sha256": "6a6d6a7ba4acd360f65d873502e234f622a7689a7ed83600f6d60976bdf0e935"
    },
    {
      "locator": "word/document.xml::p[5548]",
