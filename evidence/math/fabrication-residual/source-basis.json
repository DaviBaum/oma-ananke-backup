    },
    {
      "locator": "word/document.xml::p[4476]",
      "text": "DEF-RTR41 — Fabrication-size lifted graph",
      "text_sha256": "32adb688154576d653f0066b6ee3f92c5739bc0e519657fa33a9024c4f76382a"
    },
    {
      "locator": "word/document.xml::p[4477]",
      "text": "\\[ \\widehat G_s = V_s\\times\\mathcal W_s\\times\\mathcal K_s\\times\\Sigma_s. \\]",
      "text_sha256": "137e838bca75187dbc33218d31025b1b7b7c66c6eeacd1d13270146ee3e8c339"
    },
    {
      "locator": "word/document.xml::p[4478]",
      "text": "A transition exists only if:",
      "text_sha256": "6e21a8140de5ad4cf32433aadc11fdedce04f5f1399ed67d282daacfb2d4d667"
    },
    {
      "locator": "word/document.xml::p[4479]",
      "text": "base geometry is certified;",
      "text_sha256": "61397238e5960f4605d119d08b04947cb95a8a4e19391598e7742d46fe46a103"
    },
    {
      "locator": "word/document.xml::p[4480]",
      "text": "topology state updates correctly;",
      "text_sha256": "5fe94d55f2f6a144d066753e6c02a58dc3cadaf81eff265b45b676e8ceae0ddb"
    },
    {
      "locator": "word/document.xml::p[4481]",
      "text": "bend and straight-run rules remain admissible;",
      "text_sha256": "e29575c7a255d8ebc5c4b6186372486da63f9e18bdc97e19c8717fbb090b3baa"
    },
    {
      "locator": "word/document.xml::p[4482]",
      "text": "size transition is permitted;",
      "text_sha256": "52fd370b791d30a352ec6fa24fb6f668a684ac31675ede60fa245817bb9e76ee"
    },
    {
      "locator": "word/document.xml::p[4483]",
      "text": "support and slope state remain valid.",
      "text_sha256": "b1c4314f1d6e966544c513567be2f05c17107eee8ddaaec413d35219129e3bfa"
    },
    {
      "locator": "word/document.xml::p[4484]",
      "text": "Dominance may discard label \\(a\\) at the same base/topology state only if it is no worse in every future-relevant resource and fabrication coordinate.",
      "text_sha256": "58176a518f290234a310fc8d8807c8f717961c8df102e42968ac727bb8142fb5"
    },
    {
      "locator": "word/document.xml::p[5514]",
      "text": "ALG-RTR11 — AuditExactGeometryPredicates",
      "text_sha256": "abff16e2551891975180fb8b472ce617103883df1fb3a3611f6600c801b1db32"
    },
    {
      "locator": "word/document.xml::p[5515]",
      "text": "I/O: predicate implementation and coordinate domain \\(\\to\\) arithmetic-safety ledger.\nTrust: trusted audit. Mode: exact.\nCert: expression-bound proof and adversarial corpus.\nFailure: INTEGER_OVERFLOW_RISK, EPSILON_PREDICATE_UNSAFE.\nTime: implementation size plus tests. Checkpoint: kernel-version ledger.",
      "text_sha256": "f14c8ff319dfd220f1f04abfd6b5b78f86ae433ba25e382180aac76ade1e22f0"
    },
    {
      "locator": "word/document.xml::p[5520]",
      "text": "ALG-RTR14 — BuildHomotopyLiftedGraph",
      "text_sha256": "48d45d7fbf7d37f5006338abb0c8eea971f2391b0619575944ea1135684a32d0"
    },
    {
      "locator": "word/document.xml::p[5521]",
      "text": "I/O: base graph, edge signatures, word automaton, branch constraints \\(\\to\\widetilde G\\).\nM: lazy state interning. Trust: transition checker trusted.\nMode: exact represented classes. Det: canonical word IDs.\nCert: lift/projection certificate.\nFailure: LIFT_STATE_LIMIT; returns pricing incomplete.\nTime: represented lifted-state size.\nCheckpoint: intern table and frontier.",
      "text_sha256": "275e815ce57794531aa78dc216f2e7b2e2aea335b4cd0b7ce888c86a3ae66a29"
    },
    {
      "locator": "word/document.xml::p[5522]",
      "text": "ALG-RTR15 — BuildFabricationAndSizeLiftedGraph",
      "text_sha256": "f6ab935044d40e719e64b265ddac63699c086aec453a380d49d14c3534e00b7f"
    },
    {
      "locator": "word/document.xml::p[5523]",
      "text": "I/O: \\(\\widetilde G\\), bend, fitting, slope, support, size states \\(\\to\\widehat G\\).\nMode: exact finite state or bounded.\nFailure: STATE_EXPLOSION; UNKNOWN.\nTime: product-state output size.\nReuse: cached transition tables. Checkpoint: staged label pool.",
      "text_sha256": "eb3f88f4390429e2d5eac863e27b0664e9fca4258cd76c1a8788050cd0e85b13"
    },
    {
      "locator": "word/document.xml::p[5524]",
      "text": "ALG-RTR16 — SolveCertifiedSingleNetRoute",
      "text_sha256": "438fa0d7706303bc97cc4155df70627ff312463bb5f99ace161bd02623e7e229"
    },
    {
      "locator": "word/document.xml::p[5525]",
      "text": "I/O: lifted graph, endpoints, policy \\(\\to\\) path/skeleton and shortest-path certificate.\nTrust: search untrusted; disposal trusted.\nMode: exact if search complete and potential closes gap; otherwise feasible/bounded.\nDet: canonical.\nFailure: NO_INNER_PATH; not infeasibility.\nTime: selected graph-search bound.\nCheckpoint: search frontier.",
      "text_sha256": "8102ce5a1ecabbc84360f1307ab4caed006d45907899eb9da09c1c449a12cc00"
    },
    {
      "locator": "word/document.xml::p[5536]",
      "text": "ALG-RTR22 — CheckRouteColumn",
      "text_sha256": "c2053c604a173d2fe8b016393ea570e728c15dd520dd1c19c9c2d17c48e51dc8"
    },
    {
      "locator": "word/document.xml::p[5537]",
      "text": "I/O: column and fixed request \\(\\to\\) accepted column certificate.\nRecomputes geometry, physics, resource usage, cost enclosure, branch compatibility, and versions.\nTrust: trusted. Mode: exact/bounded.\nTime: explicit route-check cost.\nReuse: only under complete root equality.",
      "text_sha256": "bbc8a22663d07eb7fb7835cdc02886efb1ae5896c2ea5890ec99b78db0bd8b9f"
    },
    {
      "locator": "word/document.xml::p[5544]",
      "text": "ALG-RTR26 — SolveExactPricingProblem",
      "text_sha256": "5ea0e13455f9cb60635027077b4900203c29082aa2b32124dd7510de65e0e199"
    },
    {
      "locator": "word/document.xml::p[5545]",
      "text": "I/O: node dual, net, branch automaton, full represented pricing domain \\(\\to\\) optimal route column or closure certificate.\nTrust: search untrusted; optimality checker trusted.\nMode: exact.\nFailure: PRICING_INCOMPLETE.\nTime: pricing-problem complexity.\nCheckpoint: frontier/DP/MIP state.",
      "text_sha256": "74f1ae8a84029ad25a516f42798bef1f65b50a552b7fed9a4f6c91a3315ec3de"
    },
    {
