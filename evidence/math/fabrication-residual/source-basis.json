    },
    {
      "locator": "word/document.xml::p[5551]",
      "text": "I/O: checked pool and exact context \\(\\to\\) retained pool plus dominance witnesses.\nTrust: trusted comparison. Mode: exact.\nFailure: uncertain intervals prevent deletion.\nTime: naive quadratic; indexed Pareto filtering where valid.\nCheckpoint: dominance ledger.",
      "text_sha256": "de2f8b2986358920d2949749f70ee0f3013d89ca741592eaa88215c00c99de8a"
