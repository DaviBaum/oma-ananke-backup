    },
    {
      "paragraph": 16089,
      "text": "F(u0,b0)=0",
      "character_range": [
        597129,
        597139
      ],
      "utf16_range": [
        597129,
        597139
      ],
      "tables": [],
      "text_sha256": "6b020f97ead4dff458dfb0ecc3f2e6dcfd5f21fb0e172255aca67f5e225cd1b6"
    },
    {
      "paragraph": 16090,
      "text": "and",
      "character_range": [
        597140,
        597143
      ],
      "utf16_range": [
        597140,
        597143
      ],
      "tables": [],
      "text_sha256": "6201111b83a0cb5b0922cb37cc442b9a40e24e3b1ce100a4bb204f4c63fd2ac0"
    },
    {
      "paragraph": 16091,
      "text": "\\[ F_u(u_0,b_0):U\\to V \\]",
      "character_range": [
        597144,
        597169
      ],
      "utf16_range": [
        597144,
        597169
      ],
      "tables": [],
      "text_sha256": "960462f3034a59c67c7a092b9430d8ddf983b9c50c2df6bf7be4edc16ab79355"
    },
    {
      "paragraph": 16092,
      "text": "is a bounded linear isomorphism.",
      "character_range": [
        597170,
        597202
      ],
      "utf16_range": [
        597170,
        597202
      ],
      "tables": [],
      "text_sha256": "c024743e1dd183d71087da0318fda136193af7fb62458a21a3f989476f2d3436"
    },
    {
      "paragraph": 16093,
      "text": "Then there exist neighborhoods in which:",
      "character_range": [
        597203,
        597243
      ],
      "utf16_range": [
        597203,
        597243
      ],
      "tables": [],
      "text_sha256": "26c4f2c7f9077badc85889e90a2449f57f0c988f53624db6f7eac6f89be635bd"
    },
    {
      "paragraph": 16094,
      "text": "there is a unique differentiable map  ",
      "character_range": [
        597244,
        597282
      ],
      "utf16_range": [
        597244,
        597282
      ],
      "tables": [],
      "text_sha256": "d6f7d05f3a1e1ff7225cc668d9ddaebbe646b70979968faa6ad76ae5ef469b04"
    },
    {
      "paragraph": 16095,
      "text": "u=u(b)",
      "character_range": [
        597283,
        597289
      ],
      "utf16_range": [
        597283,
        597289
      ],
      "tables": [],
      "text_sha256": "1186bf789ed093cde7e5f0c636aa69eaf40356174b6ba3edd24434f9a22a3974"
    },
    {
      "paragraph": 16096,
      "text": "satisfying F(u(b),b)=0;",
      "character_range": [
        597290,
        597313
      ],
      "utf16_range": [
        597290,
        597313
      ],
      "tables": [],
      "text_sha256": "4e79e5b7b6c55e1d8f9dafca1d385a2c32a80bfe4656b89cdb835298ca9d16f2"
    },
    {
      "paragraph": 16097,
      "text": "its derivative is \\[ \\boxed{ \\frac{du}{db} = -F_u^{-1}F_b; } \\]",
      "character_range": [
        597314,
        597377
      ],
      "utf16_range": [
        597314,
        597377
      ],
      "tables": [],
      "text_sha256": "4dfacba48fdf1731d9424ea1dc3be1ad3fb4ce6b7aade3979b91c907b762b1d4"
    },
    {
      "paragraph": 16098,
      "text": "the port response  ",
      "character_range": [
        597378,
        597397
      ],
      "utf16_range": [
        597378,
        597397
      ],
      "tables": [],
      "text_sha256": "9ca27887bdd05f0c33557000004b720cdce1e149a01740908837b432fb9b6fad"
    },
    {
      "paragraph": 16099,
      "text": "r(b)=G(u(b),b)",
      "character_range": [
        597398,
        597412
      ],
      "utf16_range": [
        597398,
        597412
      ],
      "tables": [],
      "text_sha256": "d628023e6cf83fd3be733c15ae2dea377802f55c8090568b919e6235789aedc9"
    },
    {
      "paragraph": 16100,
      "text": "satisfies \\[ \\boxed{ \\frac{dr}{db} = G_b - G_uF_u^{-1}F_b. } \\]",
      "character_range": [
        597413,
        597476
      ],
      "utf16_range": [
        597413,
        597476
      ],
      "tables": [],
      "text_sha256": "0b62bd9afe72350444c10d02710a5e37230309508dd6741831b8da3e2d065320"
    },
    {
      "paragraph": 16101,
      "text": "Proof",
      "character_range": [
        597477,
        597482
      ],
      "utf16_range": [
        597477,
        597482
      ],
      "tables": [],
      "text_sha256": "7fbb3ccf9640651f69af3626de6836fb302a0a088c7cd27721c367b8b530e502"
    },
    {
      "paragraph": 16102,
      "text": "The Banach-space implicit function theorem gives existence, local uniqueness, and differentiability of u(b).",
      "character_range": [
        597483,
        597591
      ],
      "utf16_range": [
        597483,
        597591
      ],
      "tables": [],
      "text_sha256": "7a1dd14af61d8ae1021dc1d3f7821aa5ea57699983f58d283a37b454746a022d"
    },
    {
      "paragraph": 16103,
      "text": "Differentiate",
      "character_range": [
        597592,
        597605
      ],
      "utf16_range": [
        597592,
        597605
      ],
      "tables": [],
      "text_sha256": "dcc734472cfd38171932717de134fc9de2235e8ec77531deec8201b37400175f"
    },
    {
      "paragraph": 16104,
      "text": "",
      "character_range": [
        597606,
        597606
      ],
      "utf16_range": [
        597606,
        597606
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16105,
      "text": "F(u(b),b)=0:",
      "character_range": [
        597607,
        597619
      ],
      "utf16_range": [
        597607,
        597619
      ],
      "tables": [],
      "text_sha256": "9f5b90486eff7cabde80598f83f2daa021a7c9650434c449bec4732d62709006"
    },
    {
      "paragraph": 16106,
      "text": "",
      "character_range": [
        597620,
        597620
      ],
      "utf16_range": [
        597620,
        597620
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16107,
      "text": "Fududb+Fb=0.",
      "character_range": [
        597621,
        597633
      ],
      "utf16_range": [
        597621,
        597633
      ],
      "tables": [],
      "text_sha256": "f770f12bf542b87eebfba288c92b3fcab0eeb9675ebee798ba82d9c20dcc02b6"
    },
    {
      "paragraph": 16108,
      "text": "Invert Fu.",
      "character_range": [
        597634,
        597644
      ],
      "utf16_range": [
        597634,
        597644
      ],
      "tables": [],
      "text_sha256": "8463da5d9634aa5574a5d030e0449d78c6800c8341be6441634590328402adc6"
    },
    {
      "paragraph": 16109,
      "text": "Then differentiate r(b)=G(u(b),b) and substitute. ∎",
      "character_range": [
        597645,
        597696
      ],
      "utf16_range": [
        597645,
        597696
      ],
      "tables": [],
      "text_sha256": "03da42d69d0cd2749bea5fc16881f4510b5d8b4fc33820e27420e1a3593810b9"
    },
    {
      "paragraph": 16110,
      "text": "Validity boundary",
      "character_range": [
        597697,
        597714
      ],
      "utf16_range": [
        597697,
        597714
      ],
      "tables": [],
      "text_sha256": "bad374160ab3fcc6fc925a22fc018ebe571c774810102aa3e2cd757cb0cf1f0f"
    },
    {
      "paragraph": 16111,
      "text": "The theorem applies only while:",
      "character_range": [
        597715,
        597746
      ],
      "utf16_range": [
        597715,
        597746
      ],
      "tables": [],
      "text_sha256": "152ec187090496d3768d7faa6dc7e92a99c64c6185f7494ab0411511859bc181"
    },
    {
      "paragraph": 16112,
      "text": "the exact discrete regime is fixed;",
      "character_range": [
        597747,
        597782
      ],
      "utf16_range": [
        597747,
        597782
      ],
      "tables": [],
      "text_sha256": "5f79926325322691eac9dd7cba574705d0214079d746f72a0d7bf1d42dc143a1"
    },
    {
      "paragraph": 16113,
      "text": "Fu remains invertible;",
      "character_range": [
        597783,
        597805
      ],
      "utf16_range": [
        597783,
        597805
      ],
      "tables": [],
      "text_sha256": "9c5bf6f007633f750a31c227fd5b1a781b6e23eeb305aca82ba6101ae2c14031"
    },
    {
      "paragraph": 16114,
      "text": "no contact, buckling, flow reversal, threshold, or topology transition is crossed.",
      "character_range": [
        597806,
        597888
      ],
      "utf16_range": [
        597806,
        597888
      ],
      "tables": [],
      "text_sha256": "a01db0597a6a1eca2459684f5607750cfde399ccc9d60f24c23b1173d415cbf6"
    },
    {
      "paragraph": 16115,
      "text": "",
      "character_range": [
        597889,
        597889
      ],
      "utf16_range": [
        597889,
        597889
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16116,
      "text": "",
      "character_range": [
        597890,
        597890
      ],
      "utf16_range": [
        597890,
        597890
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16117,
      "text": "",
      "character_range": [
        597891,
        597891
      ],
      "utf16_range": [
        597891,
        597891
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16118,
      "text": "18. Multiple Equilibria",
      "character_range": [
        597892,
        597915
      ],
      "utf16_range": [
        597892,
        597915
      ],
      "tables": [],
      "text_sha256": "696e218f88efd18ba9899db8abbaf711ef2969370fad2a311c8079daf5a36547"
    },
    {
      "paragraph": 16119,
      "text": "THM-PO12 — Set-Valued Port Semantics for Multiple Equilibria",
      "character_range": [
        597916,
        597976
      ],
      "utf16_range": [
        597916,
        597976
      ],
      "tables": [],
      "text_sha256": "d8a3f629a42f61f58c6cab14f83f4ff1d2823ca879f55e0ba22b9675e1c28dfe"
    },
    {
      "paragraph": 16120,
      "text": "If one boundary state admits multiple internal equilibria producing different responses, any authoritative port representation must retain all admitted responses unless an exact selection rule is part of the physical theory.",
      "character_range": [
        597977,
        598201
      ],
      "utf16_range": [
        597977,
        598201
      ],
      "tables": [],
      "text_sha256": "d2153498b5202cf9df90a4bd9494feeabe9a6b6eb09739d0a885ff32c231ca1f"
    },
    {
      "paragraph": 16121,
      "text": "For safety property P:",
      "character_range": [
        598202,
        598224
      ],
      "utf16_range": [
        598202,
        598224
      ],
      "tables": [],
      "text_sha256": "98d2c656f8646289d090f29615d8661aaef15833a7c288d3645dc56d461a253f"
    },
    {
      "paragraph": 16122,
      "text": "universal safety requires \\[ \\forall r\\in\\mathcal P(b),\\quad P(r); \\]",
      "character_range": [
        598225,
        598294
      ],
      "utf16_range": [
        598225,
        598294
      ],
      "tables": [],
      "text_sha256": "37dc94795a8133224fd4193bc7249274a941e3744efef8e9fac2bbcf1e8bc3d6"
    },
    {
      "paragraph": 16123,
      "text": "existential feasibility requires \\[ \\exists r\\in\\mathcal P(b),\\quad P(r). \\]",
      "character_range": [
        598295,
        598371
      ],
      "utf16_range": [
        598295,
        598371
      ],
      "tables": [],
      "text_sha256": "5f6a487182e1913709eb8f00b4eee9ed7679a2940bbf76002288d6e72d7e1e43"
    },
    {
      "paragraph": 16124,
      "text": "A numerical solver’s returned branch alone cannot establish either universal statement.",
      "character_range": [
        598372,
        598459
      ],
      "utf16_range": [
        598372,
        598459
      ],
      "tables": [],
      "text_sha256": "9086580c186732ea433870613fcdb012f7acedf5a2aefcb54dc8f4aae79a4724"
    },
    {
      "paragraph": 16125,
      "text": "Proof",
      "character_range": [
        598460,
        598465
      ],
      "utf16_range": [
        598460,
        598465
      ],
      "tables": [],
      "text_sha256": "7fbb3ccf9640651f69af3626de6836fb302a0a088c7cd27721c367b8b530e502"
    },
    {
      "paragraph": 16126,
      "text": "Let",
      "character_range": [
        598466,
        598469
      ],
      "utf16_range": [
        598466,
        598469
      ],
      "tables": [],
      "text_sha256": "e947a3d4f4a1b23611f8aa204b2bb149785cfb02f5ccc687d1eb10b059e0d5aa"
    },
    {
      "paragraph": 16127,
      "text": "",
      "character_range": [
        598470,
        598470
      ],
      "utf16_range": [
        598470,
        598470
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16128,
      "text": "F(u)=u2-1=0,",
      "character_range": [
        598471,
        598483
      ],
      "utf16_range": [
        598471,
        598483
      ],
      "tables": [],
      "text_sha256": "b8d67d4550ccabd9ef6c97416ebbb2de5b9ebd4295dc63b35b16328ba9408de6"
    },
    {
      "paragraph": 16129,
      "text": "so equilibria are",
      "character_range": [
        598484,
        598501
      ],
      "utf16_range": [
        598484,
        598501
      ],
      "tables": [],
      "text_sha256": "c5e0ad2c4324cc3af2bc4f279facb2261225ec84283948dddc0b7ea5f20b0f7e"
    },
    {
      "paragraph": 16130,
      "text": "",
      "character_range": [
        598502,
        598502
      ],
      "utf16_range": [
        598502,
        598502
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 16131,
      "text": "u=-1,u=1.",
      "character_range": [
        598503,
        598512
      ],
      "utf16_range": [
        598503,
        598512
      ],
      "tables": [],
      "text_sha256": "947ec3daae9a1576a64f49c1bfaa2dcd0ad453ae415d792ddb73fdead815c0d5"
    },
    {
      "paragraph": 16132,
      "text": "Let response r=u, and safety property \\(r\\ge0\\).",
      "character_range": [
        598513,
        598561
      ],
      "utf16_range": [
        598513,
        598561
      ],
      "tables": [],
      "text_sha256": "3bd2ab6187f0c4be44bf0effc60b86b6816b6f9a58f2a9951271d45e6ce5ae32"
    },
    {
      "paragraph": 16133,
      "text": "A solver returning u=1 observes a safe branch, but the exact relation also contains u=-1, which is unsafe.",
      "character_range": [
        598562,
        598668
      ],
      "utf16_range": [
        598562,
        598668
      ],
      "tables": [],
      "text_sha256": "98908db092dc3cb0c259b2d55ed1a6c0d2f55b24483cb2ee962c8a8bc90e7d55"
    },
    {
      "paragraph": 16134,
      "text": "Therefore selecting one branch omits true behavior and cannot certify universal safety. ∎",
      "character_range": [
        598669,
        598758
      ],
      "utf16_range": [
        598669,
        598758
      ],
      "tables": [],
      "text_sha256": "3c58eb9fe044716aa888bea96e989445f17cbf4fc8faecb4cd2014b6c936b1b8"
    },
    {
      "paragraph": 16135,
      "text": "Evidence may justify an equilibrium-selection rule, but that rule must itself be part of the exact semantics.",
      "character_range": [
        598759,
        598868
      ],
      "utf16_range": [
        598759,
        598868
      ],
      "tables": [],
      "text_sha256": "fdb4935aed85c2dc92f26161e7792dc54e39fa18e1a60cef324bdceb9ba08631"
    },
    {
      "paragraph": 17645,
      "text": "ALG-PO2 — CompileCertifiedPortEnvelope",
      "character_range": [
        644105,
        644143
      ],
      "utf16_range": [
        644105,
        644143
      ],
      "tables": [],
      "text_sha256": "905e5206784dd023adbbfb0b2acaa9b509c05e955ddd960811f074ba0c858df1"
    },
    {
      "paragraph": 17646,
      "text": "INPUT",
      "character_range": [
        644144,
        644149
      ],
      "utf16_range": [
        644144,
        644149
      ],
      "tables": [],
      "text_sha256": "f4262548cb993257ce8409eec8b0382e2836b5dd6d9cec1e8527b458dccd3098"
    },
    {
      "paragraph": 17647,
      "text": "    full-order subsystem",
      "character_range": [
        644150,
        644174
      ],
      "utf16_range": [
        644150,
        644174
      ],
      "tables": [],
      "text_sha256": "f947ed65f01ec8c56a95674b5c3cc8d0e6f78a1187a342606a77884a9786e4b3"
    },
    {
      "paragraph": 17648,
      "text": "    port signature",
      "character_range": [
        644175,
        644193
      ],
      "utf16_range": [
        644175,
        644193
      ],
      "tables": [],
      "text_sha256": "76a4cb9e69a1eb1ec1b31d6ad23b3cede8b095059847c3dc83a7f6b83739e89f"
    },
    {
      "paragraph": 17649,
      "text": "    parameter/scenario domain",
      "character_range": [
        644194,
        644223
      ],
      "utf16_range": [
        644194,
        644223
      ],
      "tables": [],
      "text_sha256": "6f2f77a40d553ccdb8c4627c2d50688305535ba8972d1950dd79feb463de0238"
    },
    {
      "paragraph": 17650,
      "text": "    target decision budgets",
      "character_range": [
        644224,
        644251
      ],
      "utf16_range": [
        644224,
        644251
      ],
      "tables": [],
      "text_sha256": "5016877cade9a9032a899f2be528e7f0e022d1d606e8b1ff21733e8e24156b03"
    },
    {
      "paragraph": 17651,
      "text": "",
      "character_range": [
        644252,
        644252
      ],
      "utf16_range": [
        644252,
        644252
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 17652,
      "text": "1. Partition exact discrete regimes.",
      "character_range": [
        644253,
        644289
      ],
      "utf16_range": [
        644253,
        644289
      ],
      "tables": [],
      "text_sha256": "858f3bd545500a84c8d7d9ce75844c3981bd6cb1d5e3c1969ff09f11588f76ec"
    },
    {
      "paragraph": 17653,
      "text": "",
      "character_range": [
        644290,
        644290
      ],
      "utf16_range": [
        644290,
        644290
      ],
      "tables": [],
      "text_sha256": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
    },
    {
      "paragraph": 17654,
      "text": "2. Generate training or enrichment boundary states.",
      "character_range": [
        644291,
        644342
      ],
      "utf16_range": [
        644291,
        644342
      ],
      "tables": [],
      "text_sha256": "fdfc614dbfb9f83472e450390fe82881fd396e981cc9300ddfee24a01f31dc5a"
    },
    {
      "paragraph": 17655,
      "text": "",
      "character_range": [
        644343,
        644343
      ],
      "utf16_range": [
        644343,
        644343
